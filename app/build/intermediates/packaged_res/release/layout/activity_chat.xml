<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#111827">

    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#0d1117" android:minHeight="56dp" android:padding="8dp">

        <Button android:id="@+id/btnBack" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="←"
            android:textColor="#d4af37" android:background="@null"
            android:textSize="20sp"/>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="12dp">
            <TextView android:id="@+id/tvContactName" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#f1f5f9"
                android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvConnectionStatus" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="🟢 Conectado"
                android:textSize="11sp" android:textColor="#22c55e"/>
        </LinearLayout>

        <Button android:id="@+id/btnCall" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="📞"
            android:textColor="#d4af37" android:background="@null"
            android:textSize="18sp" android:layout_marginEnd="8dp"/>

        <Button android:id="@+id/btnVideoCall" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="📹"
            android:textColor="#d4af37" android:background="@null"
            android:textSize="18sp"/>
    </androidx.appcompat.widget.Toolbar>

    <ListView android:id="@+id/listView" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:divider="#1a2332" android:dividerHeight="1dp"
        android:padding="8dp" android:transcriptMode="alwaysScroll"
        android:stackFromBottom="true"/>

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:padding="8dp" android:background="#0d1117">

        <ImageButton android:id="@+id/btnAudio" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:src="@drawable/ic_mic_idle"
            android:background="@null" android:padding="8dp"
            android:layout_marginEnd="4dp"/>

        <EditText android:id="@+id/etMessage" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:hint="Mensagem..." android:textColorHint="#64748b"
            android:textColor="#f1f5f9" android:background="@drawable/bg_edit"
            android:padding="12dp"/>

        <Button android:id="@+id/btnSend" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="➤"
            android:textColor="#111827" android:background="@drawable/bg_button"
            android:padding="12dp" android:textSize="18sp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
